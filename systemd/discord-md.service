[Unit]
Description=Export Discord messages to Markdown for Perch
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=%E/discord-md/token.env
ExecStart=%h/.local/share/discord-md/venv/bin/discord-md
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
